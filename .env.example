HOST=0.0.0.0
PORT=3210
DB_PATH=/workspace/projects/write-here/db/docs.db
SSO_AUTH_BASE_URL=https://your-auth-domain.example
PUBLIC_URL=https://your-horizon-domain.example

# AI 润色：后端在本机调用 claude CLI，经 Anthropic 兼容接口接入 GPU 模型 API
# CLAUDE_CLI_PATH=claude
# ANTHROPIC_BASE_URL=https://your-gpu-model-api.example
# ANTHROPIC_API_KEY=sk-your-third-party-key
# CLAUDE_MODEL=
# CLAUDE_CLI_ARGS=-p,--output-format,text,--disallowedTools,Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch
# AI_POLISH_TIMEOUT_MS=180000
# AI_POLISH_MAX_CHARS=100000

# 远程 HTTP MCP 端点（/mcp/:secret）：ChatGPT 等远程 MCP 客户端连接用
# MCP_HTTP_SECRET=<自行设定的访问密钥>          # 未配置则不开放该端点
# HORIZON_DOCS_URL=http://127.0.0.1:3210        # MCP 工具调用后端 API 的地址
# HORIZON_DOCS_TOKEN=whmcp_xxx                  # 网站"MCP AI 接入"生成的有效个人 Token
